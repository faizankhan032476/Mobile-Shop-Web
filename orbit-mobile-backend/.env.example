# Copy this file to .env.local (same folder as package.json) and fill in the values.
# NEVER commit .env.local. Never paste these values into chat, screenshots or client code.

# --- PUBLIC (safe to expose to the browser) -----------------------------------
# Supabase dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase dashboard > Project Settings > API Keys > "Publishable key" (starts with sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional: your public site address, used in email links. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SECRET ------------------------------------------------------------------
# This app needs NO service-role / secret key and NO database password at runtime.
# All access uses the publishable key + the signed-in user's session + Row Level Security.
# (Your database password is only used by you in the Supabase dashboard / SQL Editor.)
